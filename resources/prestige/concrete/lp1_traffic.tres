[gd_resource type="Resource" script_class="LegacyBonusDef" format=3]

[ext_resource type="Script" path="res://resources/upgrades/effect.gd" id="1_effect"]
[ext_resource type="Script" path="res://resources/upgrades/effects/modify_context_stat_effect.gd" id="2_modstat"]
[ext_resource type="Script" path="res://resources/prestige/legacy_bonus_def.gd" id="3_legacydef"]

[sub_resource type="Resource" id="Effect_traffic"]
script = ExtResource("2_modstat")
stat_name = "traffic_multiplier"
multiplier = 1.15

[resource]
script = ExtResource("3_legacydef")
id = "lp1_traffic"
display_name = "Legacy Traffic (+15% foot traffic)"
required_legacy_points = 1
effects = Array[ExtResource("1_effect")]([SubResource("Effect_traffic")])
