[gd_resource type="Resource" script_class="EventDef" format=3]

[ext_resource type="Script" path="res://resources/upgrades/effect.gd" id="1_effect"]
[ext_resource type="Script" path="res://resources/upgrades/effects/modify_context_stat_effect.gd" id="2_modstat"]
[ext_resource type="Script" path="res://resources/events/event_def.gd" id="3_eventdef"]
[ext_resource type="Script" path="res://resources/events/event_choice.gd" id="4_eventchoice"]

[sub_resource type="Resource" id="Effect_traffic_boost"]
script = ExtResource("2_modstat")
stat_name = "traffic_multiplier"
multiplier = 1.5

[sub_resource type="Resource" id="Choice_fan_zone"]
script = ExtResource("4_eventchoice")
label = "Set up a fan zone"
description = "Ride the excitement — big traffic spike"
effects = Array[ExtResource("1_effect")]([SubResource("Effect_traffic_boost")])
duration_ticks = 8

[sub_resource type="Resource" id="Choice_normal"]
script = ExtResource("4_eventchoice")
label = "Business as usual"
description = "Carry on. Miss the wave."
effects = Array[ExtResource("1_effect")]([])
duration_ticks = 1

[resource]
script = ExtResource("3_eventdef")
id = "local_team_wins"
display_name = "Local Team Wins!"
description = "The local team just won a big game. The whole neighborhood is buzzing."
choices = Array[ExtResource("4_eventchoice")]([SubResource("Choice_fan_zone"), SubResource("Choice_normal")])
